// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientProfile ClientProfile?
  supportTickets SupportTicket[]
  messages      SupportMessage[]
  notifications Notification[]
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

model ClientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  phone       String?
  address     String?
  notes       String?
  loginStatus Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    ClientService[]
  quotations  Quotation[]
  invoices    Invoice[]
  payments    Payment[]
}

model ProductService {
  id           String   @id @default(uuid())
  name         String
  category     String?
  description  String?
  defaultPrice Float
  renewalPrice Float?
  billingCycle BillingCycle @default(MONTHLY)
  isRenewable  Boolean  @default(true)
  applyOnlineCharge Boolean @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientServices ClientService[]
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

model ClientService {
  id                String   @id @default(uuid())
  clientId          String
  client            ClientProfile @relation(fields: [clientId], references: [id])
  productId         String
  product           ProductService @relation(fields: [productId], references: [id])
  customName        String?
  price             Float
  renewalPrice      Float?
  billingCycle      BillingCycle @default(MONTHLY)
  startDate         DateTime
  expiryDate        DateTime?
  status            ServiceStatus @default(ACTIVE)
  notes             String?
  autoRenewReminder Boolean  @default(true)
  applyOnlineCharge Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  renewals          Renewal[]
  supportTickets    SupportTicket[]
  domainDetail      DomainDetail?
}

enum ServiceStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
  CANCELLED
}

model DomainDetail {
  id              String   @id @default(uuid())
  clientServiceId String   @unique
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  dnsNameservers  String?
  domainOwnership String?
  updatedAt       DateTime @updatedAt
}

model Renewal {
  id             String   @id @default(uuid())
  clientServiceId String
  clientService  ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  renewalDate    DateTime
  amount         Float
  status         RenewalStatus @default(PENDING)
  invoiceId      String?  @unique
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum RenewalStatus {
  PENDING
  INVOICED
  PAID
  CANCELLED
}

model Quotation {
  id          String   @id @default(uuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id])
  quoteNumber String   @unique
  date        DateTime @default(now())
  validUntil  DateTime
  notes       String?
  terms       String?
  subtotal    Float
  discount    Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float
  status      QuoteStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       QuotationItem[]
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

model QuotationItem {
  id          String   @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  total       Float
}

model Invoice {
  id            String   @id @default(uuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id])
  invoiceNumber String   @unique
  invoiceDate   DateTime @default(now())
  dueDate       DateTime
  notes         String?
  subtotal      Float
  discount      Float    @default(0)
  taxAmount     Float    @default(0)
  onlinePaymentCharge Float @default(0)
  total         Float
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         InvoiceItem[]
  payments      Payment[]
  renewal       Renewal?
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  total       Float
}

model Payment {
  id               String   @id @default(uuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  clientId         String
  client           ClientProfile @relation(fields: [clientId], references: [id])
  amount           Float
  paymentDate      DateTime @default(now())
  paymentMethod    String?  // e.g., "Cashfree"
  paymentReference String?  // e.g., Cashfree order ID
  feeAmount        Float    @default(0)
  status           PaymentStatus @default(COMPLETED)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model SupportTicket {
  id          String   @id @default(uuid())
  clientId    String
  client      User     @relation(fields: [clientId], references: [id])
  subject     String
  category    TicketCategory
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  attachment  String?
  clientServiceId String?
  clientService   ClientService? @relation(fields: [clientServiceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    SupportMessage[]
}

enum TicketCategory {
  DOMAIN
  HOSTING
  WEBSITE
  SOFTWARE
  APP
  MARKETING
  SOCIAL_MEDIA
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CLOSED
}

model SupportMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  message     String
  attachment  String?
  createdAt   DateTime @default(now())
}

model TaxSetting {
  id         String   @id @default(uuid())
  isEnabled  Boolean  @default(true)
  taxName    String   @default("GST")
  percentage Float    @default(18.0)
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model BusinessSetting {
  id          String   @id @default(uuid())
  companyName String   @default("My Company")
  address     String?
  phone       String?
  email       String?
  gstNumber   String?
  logoUrl     String?  @db.LongText
  iconUrl     String?  @db.LongText
  updatedAt   DateTime @updatedAt
}

model PaymentGatewaySetting {
  id          String   @id @default(uuid())
  provider    String   @default("CASHFREE")
  appId       String?
  secretKey   String?
  environment String   @default("TEST") // "TEST" or "PRODUCTION"
  onlinePaymentCharge Float @default(2.0)
  isActive    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String?
  isRead    Boolean  @default(false)
  icon      String   @default("tabler:bell")
  variant   String   @default("primary")
  link      String?
  createdAt DateTime @default(now())
}

model WhatsAppSetting {
  id        String   @id @default(uuid())
  apiKey    String?
  serverUrl String?
  isActive  Boolean  @default(false)
  templateRenewal         String?  @db.Text
  templateNewService      String?  @db.Text
  templatePaymentReminder String?  @db.Text
  templatePaymentReceived String?  @db.Text
  updatedAt DateTime @updatedAt
}
