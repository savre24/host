generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  name           String?
  email          String?          @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           Role             @default(CLIENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  clientProfile  ClientProfile?
  notifications  Notification[]
  messages       SupportMessage[]
  supportTickets SupportTicket[]
}

model ClientProfile {
  id          String          @id @default(uuid())
  userId      String          @unique
  companyName String?
  phone       String?
  address     String?
  notes       String?
  loginStatus Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services    ClientService[]
  invoices    Invoice[]
  payments    Payment[]
  quotations  Quotation[]
}

model ProductService {
  id                String          @id @default(uuid())
  name              String
  category          String?
  description       String?
  defaultPrice      Float
  billingCycle      BillingCycle    @default(MONTHLY)
  isRenewable       Boolean         @default(true)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  renewalPrice      Float?
  applyOnlineCharge Boolean         @default(true)
  clientServices    ClientService[]
  InvoiceItem       InvoiceItem[]
  QuotationItem     QuotationItem[]
}

model ClientService {
  id                String             @id @default(uuid())
  clientId          String
  productId         String
  customName        String?
  price             Float
  billingCycle      BillingCycle       @default(MONTHLY)
  startDate         DateTime
  expiryDate        DateTime?
  status            ServiceStatus      @default(ACTIVE)
  notes             String?
  autoRenewReminder Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  renewalPrice      Float?
  applyOnlineCharge Boolean            @default(true)
  client            ClientProfile      @relation(fields: [clientId], references: [id])
  product           ProductService     @relation(fields: [productId], references: [id])
  domainDetail      DomainDetail?
  radioServerDetail RadioServerDetail?
  renewals          Renewal[]
  supportTickets    SupportTicket[]

  @@index([clientId], map: "ClientService_clientId_fkey")
  @@index([productId], map: "ClientService_productId_fkey")
}

model DomainDetail {
  id              String        @id @default(uuid())
  clientServiceId String        @unique
  dnsNameservers  String?
  domainOwnership String?
  updatedAt       DateTime      @updatedAt
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
}

model RadioServerDetail {
  id              String        @id @default(uuid())
  clientServiceId String        @unique
  loginUrl        String?
  username        String?
  password        String?
  serverDetails   String?
  updatedAt       DateTime      @updatedAt
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
}

model Renewal {
  id              String        @id @default(uuid())
  clientServiceId String
  renewalDate     DateTime
  amount          Float
  status          RenewalStatus @default(PENDING)
  invoiceId       String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([clientServiceId], map: "Renewal_clientServiceId_fkey")
}

model Quotation {
  id          String          @id @default(uuid())
  clientId    String
  quoteNumber String          @unique
  date        DateTime        @default(now())
  validUntil  DateTime
  notes       String?
  terms       String?
  subtotal    Float
  discount    Float           @default(0)
  taxAmount   Float           @default(0)
  total       Float
  status      QuoteStatus     @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  client      ClientProfile   @relation(fields: [clientId], references: [id])
  items       QuotationItem[]

  @@index([clientId], map: "Quotation_clientId_fkey")
}

model QuotationItem {
  id          String          @id @default(uuid())
  quotationId String
  description String
  quantity    Int
  unitPrice   Float
  discount    Float           @default(0)
  taxRate     Float           @default(0)
  total       Float
  productId   String?
  product     ProductService? @relation(fields: [productId], references: [id])
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([productId], map: "QuotationItem_productId_fkey")
  @@index([quotationId], map: "QuotationItem_quotationId_fkey")
}

model Invoice {
  id                  String        @id @default(uuid())
  clientId            String
  invoiceNumber       String        @unique
  invoiceDate         DateTime      @default(now())
  dueDate             DateTime
  notes               String?
  subtotal            Float
  discount            Float         @default(0)
  taxAmount           Float         @default(0)
  total               Float
  status              InvoiceStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  onlinePaymentCharge Float         @default(0)
  client              ClientProfile @relation(fields: [clientId], references: [id])
  items               InvoiceItem[]
  payments            Payment[]
  renewal             Renewal?

  @@index([clientId], map: "Invoice_clientId_fkey")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  discount    Float           @default(0)
  taxRate     Float           @default(0)
  total       Float
  productId   String?
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     ProductService? @relation(fields: [productId], references: [id])

  @@index([invoiceId], map: "InvoiceItem_invoiceId_fkey")
  @@index([productId], map: "InvoiceItem_productId_fkey")
}

model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
  clientId         String
  amount           Float
  paymentDate      DateTime      @default(now())
  paymentMethod    String?
  paymentReference String?
  status           PaymentStatus @default(COMPLETED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  feeAmount        Float         @default(0)
  client           ClientProfile @relation(fields: [clientId], references: [id])
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([clientId], map: "Payment_clientId_fkey")
  @@index([invoiceId], map: "Payment_invoiceId_fkey")
}

model SupportTicket {
  id              String           @id @default(uuid())
  clientId        String
  subject         String
  category        TicketCategory
  priority        TicketPriority   @default(NORMAL)
  status          TicketStatus     @default(OPEN)
  attachment      String?
  clientServiceId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]
  client          User             @relation(fields: [clientId], references: [id])
  clientService   ClientService?   @relation(fields: [clientServiceId], references: [id])

  @@index([clientId], map: "SupportTicket_clientId_fkey")
  @@index([clientServiceId], map: "SupportTicket_clientServiceId_fkey")
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderId   String
  message    String
  attachment String?
  createdAt  DateTime      @default(now())
  sender     User          @relation(fields: [senderId], references: [id])
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([senderId], map: "SupportMessage_senderId_fkey")
  @@index([ticketId], map: "SupportMessage_ticketId_fkey")
}

model TaxSetting {
  id         String   @id @default(uuid())
  isEnabled  Boolean  @default(true)
  taxName    String   @default("GST")
  percentage Float    @default(18)
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model BusinessSetting {
  id          String   @id @default(uuid())
  companyName String   @default("My Company")
  address     String?
  phone       String?
  email       String?
  gstNumber   String?
  logoUrl     String?  @db.LongText
  iconUrl     String?  @db.LongText
  updatedAt   DateTime @updatedAt
}

model PaymentGatewaySetting {
  id                  String   @id @default(uuid())
  provider            String   @default("CASHFREE")
  appId               String?
  secretKey           String?
  environment         String   @default("TEST")
  isActive            Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  onlinePaymentCharge Float    @default(2)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  icon      String   @default("tabler:bell")
  variant   String   @default("primary")
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
}

model WhatsAppSetting {
  id                      String   @id @default(uuid())
  apiKey                  String?
  serverUrl               String?
  isActive                Boolean  @default(false)
  templateRenewal         String?  @db.Text
  templateNewService      String?  @db.Text
  templatePaymentReminder String?  @db.Text
  templatePaymentReceived String?  @db.Text
  updatedAt               DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum ServiceStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum RenewalStatus {
  PENDING
  INVOICED
  PAID
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TicketCategory {
  DOMAIN
  HOSTING
  WEBSITE
  SOFTWARE
  APP
  MARKETING
  SOCIAL_MEDIA
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CLOSED
}


